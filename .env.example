# ==============================================================================
# ZUNTENIUM QUANTUM SDK & CLOUD PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this template to .env and populate your credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. QUANTUM HARDWARE PROVIDERS (Physical QPUs)
# ------------------------------------------------------------------------------

# IBM Quantum Platform
# Free 10 compute minutes/month available at: https://quantum.ibm.com
# Used by: zuntenium.backends.ibm_backend & MHOS connector
IBM_QUANTUM_TOKEN="your_ibm_quantum_api_token_here"
# Optional IBM instance CRN or hub/group/project (default: open-plan / public access)
IBM_QUANTUM_INSTANCE=""

# IonQ Quantum Cloud
# Obtain API key from: https://cloud.ionq.com
# Used by: zuntenium.backend.hardware.ionq & MHOS connector
IONQ_API_KEY="your_ionq_api_key_here"

# Multi-Hardware Orchestration System (MHOS) aliases (optional / backward-compatible)
ZUNTENIUM_IBM_TOKEN="${IBM_QUANTUM_TOKEN}"
ZUNTENIUM_IONQ_API_KEY="${IONQ_API_KEY}"

# Amazon Braket (AWS Quantum Access for IonQ, Rigetti, QuEra)
# Obtain AWS credentials from AWS IAM console
ZUNTENIUM_AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"
ZUNTENIUM_AWS_SECRET="your_aws_secret_access_key_here"
ZUNTENIUM_AWS_REGION="us-east-1"
ZUNTENIUM_AWS_S3_BUCKET="your-quantum-results-s3-bucket"

# Rigetti Quantum Cloud Services (QCS)
ZUNTENIUM_RIGETTI_USER_ID=""

# ------------------------------------------------------------------------------
# 2. FRONTEND WORKSPACE (QCanvas / Next.js)
# ------------------------------------------------------------------------------
# Local dev default points to FastAPI server on port 8000
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/ws"

# ------------------------------------------------------------------------------
# 3. ZUNTENIUM CLOUD BACKEND (FastAPI, Redis, Postgres)
# ------------------------------------------------------------------------------
ZUNTENIUM_DATABASE_URL="postgresql+asyncpg://zuntenium:zuntenium@localhost:5432/zuntenium"
ZUNTENIUM_REDIS_URL="redis://localhost:6379/0"
ZUNTENIUM_JWT_SECRET="generate-a-secure-random-secret-for-production-jwt"

# ------------------------------------------------------------------------------
# 4. EXECUTION ENGINE SETTINGS
# ------------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR
ZUNTENIUM_LOG_LEVEL="INFO"
# Fallback strategy when hardware is unavailable: "simulator" or "error"
ZUNTENIUM_FALLBACK_STRATEGY="simulator"
