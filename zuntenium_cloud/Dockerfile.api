# Dockerfile.api — Zuntenium Cloud API server
FROM python:3.11-slim

LABEL maintainer="Zuntenium Cloud Platform"
LABEL description="FastAPI REST API server"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps (for bcrypt, asyncpg, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY zuntenium_cloud/requirements.txt requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

# Application code
COPY zuntenium_cloud/ ./zuntenium_cloud/
COPY zuntenium/       ./zuntenium/

# Non-root user for security
RUN addgroup --system zuntenium && adduser --system --group zuntenium
USER zuntenium

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "zuntenium_cloud.api:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "4", "--loop", "uvloop", \
     "--access-log", "--log-level", "info"]
