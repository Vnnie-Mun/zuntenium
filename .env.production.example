# ==============================================================================
# ZUNTENIUM CLOUD & WORKSPACE — DIGITALOCEAN PRODUCTION ENVIRONMENT
# ==============================================================================
# Copy this file to .env on your DigitalOcean Droplet:
#   cp .env.production.example .env
# Then update DOMAIN, passwords, and API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORK & DOMAIN (Caddy SSL Reverse Proxy)
# ------------------------------------------------------------------------------
# Set to your domain (e.g., zuntenium.example.com) for automatic HTTPS with Let's Encrypt.
# If you don't have a domain yet, set to ":80" to serve over HTTP on the Droplet's IP.
DOMAIN=":80"

# CORS Allowed Origins (comma-separated list of web clients)
ALLOWED_ORIGINS="*"

# ------------------------------------------------------------------------------
# 2. CORE SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a strong 64-char secret: openssl rand -hex 32
ZUNTENIUM_JWT_SECRET="generate-a-strong-secret-in-production-with-openssl"

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL 15)
# ------------------------------------------------------------------------------
POSTGRES_DB="zuntenium"
POSTGRES_USER="zuntenium"
POSTGRES_PASSWORD="generate-a-secure-db-password-with-openssl"

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Next.js 15 QCanvas)
# ------------------------------------------------------------------------------
# Leaving empty allows the client to automatically bind to the same domain/IP origin.
# Only specify if your API is hosted on a separate external subdomain.
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_WS_URL=""

# ------------------------------------------------------------------------------
# 5. PHYSICAL QUANTUM HARDWARE PROVIDERS (Optional)
# ------------------------------------------------------------------------------
# IBM Quantum Runtime Token
IBM_QUANTUM_TOKEN=""
ZUNTENIUM_IBM_TOKEN=""
IBM_QUANTUM_INSTANCE=""

# IonQ Cloud API Key
IONQ_API_KEY=""
ZUNTENIUM_IONQ_API_KEY=""

# Amazon Braket AWS Credentials
ZUNTENIUM_AWS_ACCESS_KEY_ID=""
ZUNTENIUM_AWS_SECRET=""
ZUNTENIUM_AWS_REGION="us-east-1"
ZUNTENIUM_AWS_S3_BUCKET=""

# Rigetti Quantum Cloud Services
ZUNTENIUM_RIGETTI_USER_ID=""

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY (Optional / Profile "monitoring")
# ------------------------------------------------------------------------------
GRAFANA_PASSWORD="admin_change_this_password"
ZUNTENIUM_LOG_LEVEL="INFO"
